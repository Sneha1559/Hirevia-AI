
# Python
__pycache__/
*.py[cod]
*.pyd

# Virtual environment
.venv/
venv/
env/

# Secrets and environment variables
.env
.env.*
!.env.example

# Uploaded resumes and private candidate data
data/resumes/*
data/job_descriptions/*
data/processed/*

# Database files
database/*.db
database/*.sqlite
database/*.sqlite3

# Generated reports
exports/*

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.streamlit/secrets.toml

# IDE and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db


@"
venv/
.venv/
__pycache__/
*.py[cod]
.env
.streamlit/secrets.toml
*.db
*.sqlite
*.sqlite3
"@ | Out-File -Encoding utf8 .gitignore